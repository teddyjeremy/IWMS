@baseUrl = https://localhost:5071
### Sign in as the warehouse operator
# @name loginOperator
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{ "email": "operator@iwms.local", "password": "Gzdwa2$2002" }

### Sign in as the warehouse manager
# @name loginManager
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{ "email": "manager@iwms.local", "password": "Gzdwa2$2002" }

### Sign in as the administrator
# @name loginAdmin
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{ "email": "admin@iwms.local", "password": "Gzdwa2$2002" }

### Sign in as the viewer
# @name loginViewer
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{ "email": "viewer@iwms.local", "password": "Gzdwa2$2002" }

### Who am I?
GET {{baseUrl}}/api/auth/me
Authorization: Bearer {{loginOperator.response.body.$.token}}

### Health check
GET {{baseUrl}}/health

### Users (copy the operator's Id)
GET {{baseUrl}}/api/users

### Warehouses and locations (copy the Id of A-01 and B-01)
GET {{baseUrl}}/api/warehouses

### Products (search is optional; copy the hammer's Id)
GET {{baseUrl}}/api/products?search=ham

### Purchase orders (copy the Id of PO-0001)
GET {{baseUrl}}/api/purchase-orders

### Purchase order detail (copy the line Id)
GET {{baseUrl}}/api/purchase-orders/PASTE-PO-ID

### Receive 60 of 100 (first delivery)
POST {{baseUrl}}/api/receipts
Content-Type: application/json

{
  "purchaseOrderId": "PASTE-PO-ID",
  "receivedByUserId": "PASTE-OPERATOR-USER-ID",
  "idempotencyKey": "aaaaaaaa-0000-0000-0000-000000000001",
  "allowOverReceipt": false,
  "notes": "First delivery",
  "lines": [
    {
      "purchaseOrderLineId": "PASTE-LINE-ID",
      "storageLocationId": "PASTE-LOCATION-A01-ID",
      "quantityAccepted": 60,
      "quantityRejected": 0,
      "discrepancyNote": ""
    }
  ]
}

### Receive the remaining 40 (new idempotency key)
POST {{baseUrl}}/api/receipts
Content-Type: application/json

{
  "purchaseOrderId": "PASTE-PO-ID",
  "receivedByUserId": "PASTE-OPERATOR-USER-ID",
  "idempotencyKey": "aaaaaaaa-0000-0000-0000-000000000002",
  "allowOverReceipt": false,
  "notes": "Second delivery",
  "lines": [
    {
      "purchaseOrderLineId": "PASTE-LINE-ID",
      "storageLocationId": "PASTE-LOCATION-A01-ID",
      "quantityAccepted": 40,
      "quantityRejected": 0,
      "discrepancyNote": ""
    }
  ]
}

### Issue 25 units
POST {{baseUrl}}/api/stock/issue
Content-Type: application/json

{
  "productId": "PASTE-PRODUCT-ID",
  "storageLocationId": "PASTE-LOCATION-A01-ID",
  "quantity": 25,
  "performedByUserId": "PASTE-OPERATOR-USER-ID",
  "idempotencyKey": "bbbbbbbb-0000-0000-0000-000000000001",
  "referenceNumber": "SO-DEMO-1",
  "reason": "Manual issue"
}

### Adjust: decrease by 2 (a reason is required)
POST {{baseUrl}}/api/stock/adjust
Content-Type: application/json

{
  "productId": "PASTE-PRODUCT-ID",
  "storageLocationId": "PASTE-LOCATION-A01-ID",
  "quantity": 2,
  "isIncrease": false,
  "reason": "Damaged during handling",
  "performedByUserId": "PASTE-OPERATOR-USER-ID",
  "idempotencyKey": "cccccccc-0000-0000-0000-000000000001"
}

### Transfer 10 from A-01 to B-01
POST {{baseUrl}}/api/stock/transfer
Content-Type: application/json

{
  "productId": "PASTE-PRODUCT-ID",
  "fromStorageLocationId": "PASTE-LOCATION-A01-ID",
  "toStorageLocationId": "PASTE-LOCATION-B01-ID",
  "quantity": 10,
  "reason": "Rebalancing",
  "performedByUserId": "PASTE-OPERATOR-USER-ID",
  "idempotencyKey": "dddddddd-0000-0000-0000-000000000001"
}

### Movement history (newest first)
GET {{baseUrl}}/api/movements?pageSize=25

### Product detail with stock by location
GET {{baseUrl}}/api/products/PASTE-PRODUCT-ID

### Ledger vs balance check (an empty list [] means consistent)
GET {{baseUrl}}/api/stock/reconciliation

### Sign in as the purchaser
# @name loginPurchaser
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{ "email": "purchaser@iwms.local", "password": "YOUR-DEMO-PASSWORD" }

### Suppliers
GET {{baseUrl}}/api/suppliers
Authorization: Bearer {{loginPurchaser.response.body.$.token}}

### Create a purchase order (use ids from products and suppliers)
POST {{baseUrl}}/api/purchase-orders
Content-Type: application/json
Authorization: Bearer {{loginPurchaser.response.body.$.token}}

{
  "supplierId": "PASTE-SUPPLIER-ID",
  "expectedDeliveryUtc": "2026-11-15T00:00:00Z",
  "notes": "Restock hammers and screws",
  "lines": [
    { "productId": "PASTE-HAMMER-PRODUCT-ID", "quantity": 50, "expectedUnitPrice": 8.5 },
    { "productId": "PASTE-SCREWS-PRODUCT-ID", "quantity": 200, "expectedUnitPrice": 3.2 }
  ],
  "version": 0
}

### Submit it
POST {{baseUrl}}/api/purchase-orders/PASTE-NEW-ORDER-ID/submit
Authorization: Bearer {{loginPurchaser.response.body.$.token}}

### Try to approve as the purchaser (expect 403)
POST {{baseUrl}}/api/purchase-orders/PASTE-NEW-ORDER-ID/approve
Authorization: Bearer {{loginPurchaser.response.body.$.token}}

### Approve as the manager
POST {{baseUrl}}/api/purchase-orders/PASTE-NEW-ORDER-ID/approve
Authorization: Bearer {{loginManager.response.body.$.token}}

### Reject instead (with a reason), as the manager
POST {{baseUrl}}/api/purchase-orders/PASTE-NEW-ORDER-ID/reject
Content-Type: application/json
Authorization: Bearer {{loginManager.response.body.$.token}}

{ "reason": "Price is above the agreed supplier rate" }

### Order detail with approval history
GET {{baseUrl}}/api/purchase-orders/PASTE-NEW-ORDER-ID
Authorization: Bearer {{loginPurchaser.response.body.$.token}}

### Approval inbox
GET {{baseUrl}}/api/purchase-orders?status=Submitted
Authorization: Bearer {{loginManager.response.body.$.token}}

### Receipts with discrepancies
GET {{baseUrl}}/api/receipts?hasDiscrepancy=true
Authorization: Bearer {{loginOperator.response.body.$.token}}

### Reverse a receipt (manager)
POST {{baseUrl}}/api/receipts/PASTE-RECEIPT-ID/reverse
Content-Type: application/json
Authorization: Bearer {{loginManager.response.body.$.token}}

{ "reason": "Delivered to the wrong warehouse" }

### Reverse a single movement, for example an adjustment (manager)
POST {{baseUrl}}/api/movements/PASTE-MOVEMENT-ID/reverse
Content-Type: application/json
Authorization: Bearer {{loginManager.response.body.$.token}}

{ "reason": "Adjustment entered against the wrong product" }