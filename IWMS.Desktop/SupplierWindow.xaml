<Window x:Class="IWMS.Desktop.SupplierWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New supplier" Height="560" Width="520" WindowStartupLocation="CenterOwner"
        Background="{StaticResource PageBackground}" ResizeMode="NoResize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="New supplier" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="0,0,0,14"/>
        <StackPanel Grid.Row="1">
            <TextBlock Text="Name *"/><TextBox x:Name="NameBox"/>
            <TextBlock Text="Contact person"/><TextBox x:Name="ContactBox"/>
            <TextBlock Text="Email"/><TextBox x:Name="EmailBox"/>
            <TextBlock Text="Phone"/><TextBox x:Name="PhoneBox"/>
            <TextBlock Text="Address"/><TextBox x:Name="AddressBox" AcceptsReturn="True" Height="60" TextWrapping="Wrap"/>
            <CheckBox x:Name="ActiveBox" Content="Supplier is active" IsChecked="True" Margin="0,0,0,8"/>
            <TextBlock x:Name="ErrorText" Foreground="#B42318" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Click="Cancel_Click"/>
            <Button Content="Create supplier" Click="Save_Click" IsDefault="True" Style="{StaticResource PrimaryButton}"/>
        </StackPanel>
    </Grid>
</Window>
