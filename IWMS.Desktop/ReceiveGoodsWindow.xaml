<Window x:Class="IWMS.Desktop.ReceiveGoodsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Receive goods" Height="680" Width="920" MinHeight="560" MinWidth="760"
        WindowStartupLocation="CenterOwner" Background="{StaticResource PageBackground}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <TextBlock x:Name="HeaderText" Text="Receive goods" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
            <TextBlock x:Name="SubtitleText" Text="Enter accepted and rejected quantities for the outstanding lines." Foreground="{StaticResource MutedInk}" Margin="0,6,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <StackPanel x:Name="LinesHost"/>
                <TextBlock Text="Receipt notes" Margin="0,8,0,0"/>
                <TextBox x:Name="NotesBox" AcceptsReturn="True" Height="60" TextWrapping="Wrap"/>
                <TextBlock x:Name="ErrorText" Foreground="#B42318" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Click="Cancel_Click"/>
            <Button x:Name="SaveButton" Content="Post receipt" Click="Save_Click" IsDefault="True" Style="{StaticResource PrimaryButton}"/>
        </StackPanel>
    </Grid>
</Window>
