<Window x:Class="IWMS.Desktop.NewCustomerWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="New customer" Height="480" Width="520" WindowStartupLocation="CenterOwner">
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="Add customer" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,18"/>
  <StackPanel Grid.Row="1">
   <TextBlock Text="Customer name *"/><TextBox x:Name="NameBox"/>
   <TextBlock Text="Email *"/><TextBox x:Name="EmailBox"/>
   <TextBlock Text="Phone"/><TextBox x:Name="PhoneBox"/>
   <TextBlock Text="Address"/><TextBox x:Name="AddressBox"/>
   <TextBlock x:Name="ErrorText" Foreground="DarkRed" TextWrapping="Wrap"/>
  </StackPanel>
  <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
   <Button Content="Cancel" Click="Cancel_Click"/>
   <Button Content="Save customer" Click="Save_Click" IsDefault="True"/>
  </StackPanel>
 </Grid>
</Window>