<Window x:Class="IWMS.Desktop.PickShipmentWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Pick shipment" Height="560" Width="850" WindowStartupLocation="CenterOwner">
 <Grid Margin="20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,14">
   <TextBlock x:Name="HeadingText" Text="Record picked quantities" FontSize="23" FontWeight="SemiBold"/>
   <TextBlock Text="Enter the quantities physically picked at each location. All lines must be fully picked before dispatch." Foreground="Gray" TextWrapping="Wrap" Margin="0,6,0,0"/>
  </StackPanel>
  <DataGrid x:Name="LinesGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" Margin="0,0,0,12">
   <DataGrid.Columns>
    <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" IsReadOnly="True" Width="100"/>
    <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" IsReadOnly="True" Width="*"/>
    <DataGridTextColumn Header="Location" Binding="{Binding Location}" IsReadOnly="True" Width="120"/>
    <DataGridTextColumn Header="To pick" Binding="{Binding QuantityToPick}" IsReadOnly="True" Width="100"/>
    <DataGridTextColumn Header="Picked" Binding="{Binding QuantityPicked, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
   </DataGrid.Columns>
  </DataGrid>
  <StackPanel Grid.Row="2">
   <TextBlock x:Name="ErrorText" Foreground="DarkRed" TextWrapping="Wrap" Margin="0,0,0,8"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
    <Button Content="Cancel" Click="Cancel_Click"/>
    <Button Content="Save picked quantities" Click="Save_Click" IsDefault="True"/>
   </StackPanel>
  </StackPanel>
 </Grid>
</Window>