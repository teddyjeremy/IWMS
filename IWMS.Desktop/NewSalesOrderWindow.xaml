<Window x:Class="IWMS.Desktop.NewSalesOrderWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="New sales order" Height="600" Width="560" WindowStartupLocation="CenterOwner">
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="Create sales order" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,18"/>
  <StackPanel Grid.Row="1">
   <TextBlock Text="Customer *"/><ComboBox x:Name="CustomerBox" DisplayMemberPath="Label" SelectedValuePath="Id" Padding="8" Margin="0,4,0,12"/>
   <TextBlock Text="Product *"/><ComboBox x:Name="ProductBox" DisplayMemberPath="Label" SelectedValuePath="Id" Padding="8" Margin="0,4,0,12"/>
   <TextBlock Text="Quantity *"/><TextBox x:Name="QuantityBox" Text="1"/>
   <TextBlock Text="Unit price *"/><TextBox x:Name="UnitPriceBox" Text="0"/>
   <TextBlock Text="Required date (UTC, optional)"/><DatePicker x:Name="RequiredDatePicker" Margin="0,4,0,12"/>
   <TextBlock Text="Notes"/><TextBox x:Name="NotesBox" AcceptsReturn="True" Height="55" TextWrapping="Wrap"/>
   <TextBlock x:Name="ErrorText" Foreground="DarkRed" TextWrapping="Wrap" Margin="0,8,0,0"/>
  </StackPanel>
  <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
   <Button Content="Cancel" Click="Cancel_Click"/>
   <Button Content="Create order" Click="Create_Click" IsDefault="True"/>
  </StackPanel>
 </Grid>
</Window>