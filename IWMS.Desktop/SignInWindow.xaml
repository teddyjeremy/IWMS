<Window x:Class="IWMS.Desktop.SignInWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Connect to IWMS" Height="410" Width="500" WindowStartupLocation="CenterOwner">
 <Grid Margin="24">
  <StackPanel>
   <TextBlock Text="Connect to IWMS" FontSize="24" Margin="0,0,0,16"/>
   <TextBlock Text="API base URL"/>
   <TextBox x:Name="ApiUrlBox" Text="https://localhost:7001/"/>
   <TextBlock Text="Email"/>
   <TextBox x:Name="EmailBox"/>
   <TextBlock Text="Password"/>
   <PasswordBox x:Name="PasswordBox" Padding="8" Margin="0,4,0,12"/>
   <TextBlock x:Name="ErrorText" Foreground="DarkRed" TextWrapping="Wrap" Margin="0,0,0,8"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
    <Button Content="Cancel" Click="Cancel_Click"/>
    <Button Content="Sign in" Click="SignIn_Click" IsDefault="True"/>
   </StackPanel>
  </StackPanel>
 </Grid>
</Window>