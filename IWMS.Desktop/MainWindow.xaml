<Window x:Class="IWMS.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IWMS | Inventory and Warehouse Management"
        Height="780" Width="1280" MinHeight="620" MinWidth="960"
        WindowStartupLocation="CenterScreen" Background="{StaticResource PageBackground}">
    <Grid>
        <Grid x:Name="ShellRoot" Visibility="Collapsed">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="246"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Background="#122F43" Grid.Column="0">
            <DockPanel Margin="18">
                <StackPanel DockPanel.Dock="Top" Margin="0,8,0,24">
                    <TextBlock Text="IWMS" Foreground="White" FontSize="28" FontWeight="Bold"/>
                    <TextBlock Text="WAREHOUSE OPERATIONS" Foreground="#AFC6D4" FontSize="10" FontWeight="SemiBold" Margin="0,5,0,0"/>
                    <Border Height="1" Background="#315164" Margin="0,20,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <Border Height="1" Background="#315164" Margin="0,0,0,14"/>
                    <TextBlock x:Name="ConnectionLabel" Text="Signed in" Foreground="#C8D6DF" TextWrapping="Wrap" Margin="0,0,0,5"/>
                    <TextBlock x:Name="RoleLabel" Text="Workspace" Foreground="#86A9BC" FontSize="11" Margin="0,0,0,12"/>
                    <Button Content="Sign out" Click="SignOut_Click" HorizontalContentAlignment="Left"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="WORKSPACE" Foreground="#86A9BC" FontSize="10" FontWeight="SemiBold" Margin="10,0,0,8"/>
                    <Button x:Name="DashboardNavButton" Content="Dashboard" Tag="Dashboard" Click="Navigate_Click" HorizontalContentAlignment="Left"/>
                    <Button x:Name="CustomersNavButton" Content="Customers" Tag="Customers" Click="Navigate_Click" HorizontalContentAlignment="Left"/>
                    <Button x:Name="SalesOrdersNavButton" Content="Sales orders" Tag="Sales orders" Click="Navigate_Click" HorizontalContentAlignment="Left"/>
                    <Button x:Name="FulfillmentNavButton" Content="Fulfillment" Tag="Fulfillment" Click="Navigate_Click" HorizontalContentAlignment="Left"/>
                    <Button x:Name="TransfersNavButton" Content="Stock transfers" Tag="Stock transfers" Click="Navigate_Click" HorizontalContentAlignment="Left"/>
                    <Button x:Name="CountsNavButton" Content="Stock counts" Tag="Stock counts" Click="Navigate_Click" HorizontalContentAlignment="Left"/>
                    <Button x:Name="ReturnsNavButton" Content="Returns" Tag="Returns" Click="Navigate_Click" HorizontalContentAlignment="Left"/>
                    <Button x:Name="InventoryNavButton" Content="Inventory" Tag="Inventory" Click="Navigate_Click" HorizontalContentAlignment="Left"/>
                    <Button x:Name="PurchasingNavButton" Content="Purchasing" Tag="Purchasing" Click="Navigate_Click" HorizontalContentAlignment="Left"/>
                    <Button x:Name="ReportsNavButton" Content="Reports &amp; exports" Tag="Reports" Click="Navigate_Click" HorizontalContentAlignment="Left"/>
                    <Button Content="Users &amp; access" x:Name="UsersNavButton" Tag="Users" Click="Navigate_Click" HorizontalContentAlignment="Left" Visibility="Collapsed"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1" Margin="32,28,32,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                <TextBlock x:Name="PageTitle" Text="Dashboard" FontSize="30" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
                <TextBlock x:Name="PageSubtitle" Text="Inventory position and warehouse activity" FontSize="14" Foreground="{StaticResource MutedInk}" Margin="0,6,0,0"/>
            </StackPanel>
            <ContentControl x:Name="PageContent" Grid.Row="1"/>
            <Border Grid.Row="2" Background="#E9EFF4" CornerRadius="8" Padding="12,9" Margin="0,16,0,0">
                <TextBlock x:Name="StatusText" Text="Connect to the IWMS API to load live data." Foreground="{StaticResource MutedInk}" TextWrapping="Wrap"/>
            </Border>
        </Grid>
        </Grid>
        <Grid x:Name="LoginRoot" Visibility="Visible" Background="#F2F5F8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#122F43">
                <StackPanel VerticalAlignment="Center" Margin="56">
                    <Border Width="64" Height="64" Background="#2B6D8A" CornerRadius="14" HorizontalAlignment="Left" Margin="0,0,0,28">
                        <TextBlock Text="W" Foreground="White" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="IWMS" Foreground="White" FontSize="38" FontWeight="Bold"/>
                    <TextBlock Text="INVENTORY &amp; WAREHOUSE MANAGEMENT" Foreground="#B8D0DE" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,28"/>
                    <TextBlock Text="A clearer view of every movement." Foreground="White" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="440"/>
                    <TextBlock Text="Manage inventory, orders, transfers and warehouse operations from one secure workspace." Foreground="#D0DCE4" FontSize="15" TextWrapping="Wrap" MaxWidth="440" Margin="0,16,0,0" LineHeight="24"/>
                </StackPanel>
            </Border>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel VerticalAlignment="Center" Margin="48" MaxWidth="430">
                    <TextBlock Text="Welcome back" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                    <TextBlock Text="Sign in to continue to your workspace." FontSize="14" Foreground="{StaticResource MutedInk}" Margin="0,8,0,28"/>
                    <TextBlock Text="API server address" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                    <TextBox x:Name="LoginApiUrlBox" Text="https://localhost:7001/" MinWidth="0" ToolTip="Use your deployed HTTPS API address in production."/>
                    <TextBlock Text="Work email" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                    <TextBox x:Name="LoginEmailBox" MinWidth="0" ToolTip="Enter the email associated with your IWMS account."/>
                    <TextBlock Text="Password" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                    <PasswordBox x:Name="LoginPasswordBox" Padding="9,7" Margin="0,4,0,12" ToolTip="Enter your IWMS password."/>
                    <TextBlock x:Name="LoginErrorText" Foreground="#B42318" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <Button x:Name="LoginButton" Content="Sign in securely" Click="SignIn_Click" IsDefault="True" Background="#174A68" Foreground="White" Padding="14,12" HorizontalContentAlignment="Center" FontWeight="SemiBold"/>
                    <TextBlock Text="Access is restricted to authorized IWMS users." FontSize="12" Foreground="{StaticResource MutedInk}" TextWrapping="Wrap" Margin="0,18,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>