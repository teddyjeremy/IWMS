<Window x:Class="IWMS.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IWMS | Inventory & Warehouse Management"
        Icon="Assets/IWMS.ico"
        Height="860" Width="1360" MinHeight="680" MinWidth="1080"
        WindowStartupLocation="CenterScreen" Background="{StaticResource PageBackground}">
    <Grid>
        <Grid x:Name="ShellRoot" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Background="#102A3C" Grid.Column="0">
                <DockPanel Margin="16,18,16,16">
                    <StackPanel DockPanel.Dock="Top" Margin="4,4,4,16">
                        <TextBlock Text="IWMS" Foreground="White" FontSize="26" FontWeight="Bold"/>
                        <TextBlock Text="WAREHOUSE OPERATIONS" Foreground="#9BB6C6" FontSize="10" FontWeight="SemiBold" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom">
                        <Border Height="1" Background="#2C4A5C" Margin="0,0,0,12"/>
                        <TextBlock x:Name="ConnectionLabel" Text="Signed in" Foreground="#E7F0F5" TextWrapping="Wrap" FontWeight="SemiBold" Margin="4,0,0,2"/>
                        <TextBlock x:Name="RoleLabel" Text="Workspace" Foreground="#8EADC0" FontSize="12" Margin="4,0,0,12"/>
                        <Button Content="Sign out" Style="{StaticResource NavButton}" Click="SignOut_Click"/>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="OVERVIEW" Foreground="#7F9AAD" FontSize="10" FontWeight="Bold" Margin="12,4,0,6"/>
                            <Button x:Name="DashboardNavButton" Content="Dashboard" Tag="Dashboard" Style="{StaticResource NavButton}" Click="Navigate_Click"/>
                            <Button x:Name="ReportsNavButton" Content="Reports" Tag="Reports" Style="{StaticResource NavButton}" Click="Navigate_Click"/>
                            <TextBlock x:Name="CommercialHeading" Text="COMMERCIAL" Foreground="#7F9AAD" FontSize="10" FontWeight="Bold" Margin="12,14,0,6"/>
                            <Button x:Name="CustomersNavButton" Content="Customers" Tag="Customers" Style="{StaticResource NavButton}" Click="Navigate_Click"/>
                            <Button x:Name="SalesOrdersNavButton" Content="Sales orders" Tag="Sales orders" Style="{StaticResource NavButton}" Click="Navigate_Click"/>
                            <Button x:Name="SuppliersNavButton" Content="Suppliers" Tag="Suppliers" Style="{StaticResource NavButton}" Click="Navigate_Click"/>
                            <Button x:Name="PurchasingNavButton" Content="Purchasing" Tag="Purchasing" Style="{StaticResource NavButton}" Click="Navigate_Click"/>
                            <TextBlock x:Name="WarehouseHeading" Text="WAREHOUSE" Foreground="#7F9AAD" FontSize="10" FontWeight="Bold" Margin="12,14,0,6"/>
                            <Button x:Name="InventoryNavButton" Content="Inventory" Tag="Inventory" Style="{StaticResource NavButton}" Click="Navigate_Click"/>
                            <Button x:Name="FulfillmentNavButton" Content="Fulfillment" Tag="Fulfillment" Style="{StaticResource NavButton}" Click="Navigate_Click"/>
                            <Button x:Name="TransfersNavButton" Content="Transfers" Tag="Stock transfers" Style="{StaticResource NavButton}" Click="Navigate_Click"/>
                            <Button x:Name="CountsNavButton" Content="Stock counts" Tag="Stock counts" Style="{StaticResource NavButton}" Click="Navigate_Click"/>
                            <Button x:Name="ReturnsNavButton" Content="Returns" Tag="Returns" Style="{StaticResource NavButton}" Click="Navigate_Click"/>
                            <Button x:Name="ReceiptsNavButton" Content="Receipts" Tag="Receipts" Style="{StaticResource NavButton}" Click="Navigate_Click"/>
                            <Button x:Name="MovementsNavButton" Content="Movements" Tag="Movements" Style="{StaticResource NavButton}" Click="Navigate_Click"/>
                            <TextBlock x:Name="AdminHeading" Text="ADMINISTRATION" Foreground="#7F9AAD" FontSize="10" FontWeight="Bold" Margin="12,14,0,6"/>
                            <Button x:Name="AuditNavButton" Content="Audit trail" Tag="Audit" Style="{StaticResource NavButton}" Click="Navigate_Click" Visibility="Collapsed"/>
                            <Button x:Name="UsersNavButton" Content="Users & access" Tag="Users" Style="{StaticResource NavButton}" Click="Navigate_Click" Visibility="Collapsed"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
            <Grid Grid.Column="1" Margin="28,22,28,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="PageTitle" Text="Dashboard" FontSize="28" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
                        <TextBlock x:Name="PageSubtitle" Text="Inventory position and warehouse activity" FontSize="14" Foreground="{StaticResource MutedInk}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Refresh" VerticalAlignment="Center" Click="Refresh_Click" Padding="16,8"/>
                </Grid>
                <ContentControl x:Name="PageContent" Grid.Row="1"/>
                <Border Grid.Row="2" Background="#E7EEF3" CornerRadius="8" Padding="12,9" Margin="0,12,0,0">
                    <TextBlock x:Name="StatusText" Text="Connect to the IWMS API to load live data." Foreground="{StaticResource MutedInk}" TextWrapping="Wrap"/>
                </Border>
            </Grid>
        </Grid>
        <Grid x:Name="LoginRoot" Visibility="Visible" Background="#F2F5F8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#102A3C">
                <StackPanel VerticalAlignment="Center" Margin="56">
                    <Border Width="64" Height="64" Background="#1F5674" CornerRadius="14" HorizontalAlignment="Left" Margin="0,0,0,28">
                        <Image Source="Assets/IWMS.ico" Width="48" Height="48" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="IWMS" Foreground="White" FontSize="38" FontWeight="Bold"/>
                    <TextBlock Text="INVENTORY & WAREHOUSE MANAGEMENT" Foreground="#B8D0DE" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel VerticalAlignment="Center" Margin="48" MaxWidth="430">
                    <TextBlock Text="Welcome back" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                    <TextBlock Text="Sign in to continue to your workspace." FontSize="14" Foreground="{StaticResource MutedInk}" Margin="0,8,0,28"/>
                    <TextBlock Text="Work email" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                    <TextBox x:Name="LoginEmailBox" MinWidth="0"/>
                    <TextBlock Text="Password" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                    <PasswordBox x:Name="LoginPasswordBox" Padding="9,7" Margin="0,4,0,12"/>
                    <TextBlock x:Name="LoginErrorText" Foreground="#B42318" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <Button x:Name="LoginButton" Content="Sign in securely" Click="SignIn_Click" IsDefault="True" Style="{StaticResource PrimaryButton}" HorizontalContentAlignment="Center" Padding="14,12"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
