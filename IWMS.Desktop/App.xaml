<Application x:Class="IWMS.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="PageBackground" Color="#F4F6F8"/>
        <SolidColorBrush x:Key="Ink" Color="#17212B"/>
        <SolidColorBrush x:Key="MutedInk" Color="#667085"/>
        <SolidColorBrush x:Key="Brand" Color="#174A68"/>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="Margin" Value="0,4,0,12"/>
            <Setter Property="MinWidth" Value="240"/>
        </Style>
    </Application.Resources>
</Application>